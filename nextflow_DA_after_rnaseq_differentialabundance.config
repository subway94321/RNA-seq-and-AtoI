// 1. 全局核心参数（仅保留必要配置，不与命令行冲突）
params {
    // 容器相关：与提交脚本的 NXF_SINGULARITY_CACHEDIR 一致
    singularity_cache_dir = "$HOME/singularity_cache"
    singularity_pull_timeout = "60m"  // 替代命令行 -c 参数，统一管理
    
    // 临时目录：避免依赖集群共享 /tmp，解决文件创建权限问题
    tmpdir = "$PWD/global_tmp_DA"  // 差异分析专属临时目录（避免与RNA-seq冲突）
}

// 2. 进程资源配置（严格匹配 SLURM 申请的 15 CPU / 80GB 内存）
process {
    // 全局资源限制：不超过提交脚本申请的总资源
    resourceLimits = [
        cpus: 15,
        memory: 80.GB,
        time: 24.h  // 预留充足运行时间，避免超时
    ]
    
    // 关键：传递临时目录环境变量（解决容器内 /tmp 访问问题）
    env {
        TMPDIR = params.tmpdir
    }
    
    // 按任务类型精准配置（适配 differentialabundance 核心任务）
    // 差异分析核心任务（如 DESeq2/edgeR）：中等资源需求
    withLabel: "process_medium" {
        cpus = 8
        memory = 40.GB
        time = 8.h
        errorStrategy = "retry"
        maxRetries = 1  // 失败自动重试1次，提高稳定性
    }
    
    // 数据预处理任务（如矩阵过滤、注释）：低资源需求
    withLabel: "process_low" {
        cpus = 4
        memory = 20.GB
        time = 4.h
    }
    
    // 可视化任务（如火山图、热图）：低资源需求
    withName: "PLOT_*" {
        cpus = 4
        memory = 15.GB
        time = 2.h
    }
    
    // 全局默认配置（未匹配标签的任务使用）
    cpus = 6
    memory = 30.GB
    time = 6.h
    errorStrategy = "terminate"  // 非核心任务失败直接终止，避免无效重试
}

// 3. 容器配置（严格遵循官方规范，与提交脚本一致）
singularity {
    enabled = true
    autoMounts = true  // 自动挂载宿主目录，确保输入文件/临时目录可访问
    cacheDir = params.singularity_cache_dir
    pullTimeout = params.singularity_pull_timeout
    pullRateLimit = "100MB"  // 避免镜像下载限速导致失败
    runOptions = "--cleanenv"  // 清理容器环境，减少冲突
}

// 4. 执行器配置（与提交脚本完全对齐）
executor {
    name = "local"  // 核心：改为本地执行
    maxParallelProcesses = 2  // 最大并行任务数（≤ sbatch 申请的 CPU 数，避免资源超用）
}
// 5. 日志与追踪配置（官方推荐，方便排查问题）
trace {
    enabled = true
    file = "${params.outdir}/nextflow_trace.txt"
    fields = "task_id,name,status,exit,cpus,memory,time,duration,attempt"  // 新增重试次数字段
}

report {
    enabled = true
    file = "${params.outdir}/nextflow_report.html"  // 可视化运行报告
}

timeline {
    enabled = true
    file = "${params.outdir}/nextflow_timeline.html"  // 任务时间线，便于优化资源
}

// 6. 兼容性与稳定性配置
manifest {
    nextflowVersion = ">=22.10.0"  // 匹配流程1.5.0版本的最低Nextflow要求
    description = "nf-core/differentialabundance 差异丰度分析（基于RNA-seq定量结果）"
    author = "sunxiaozhi"
    version = "1.5.0"  // 与流程版本一致，便于追溯
}

// 7. 资源弹性调整（官方高级功能，避免资源浪费）
wave {
    wave.enabled = false
    singularity.enabled = true
    singularity.cacheDir = "$HOME/singularity_cache"
}


// 8. 缓存配置（支持断点续跑，加速重复运行）
cache {
    enabled = true
    dir = "$PWD/nextflow_cache_DA"  // 差异分析专属缓存目录（避免与RNA-seq冲突）
}

// 9. 额外优化：解决常见兼容性问题
env {
    // 强制Java使用指定临时目录（避免容器内Java报错）
    JAVA_TOOL_OPTIONS = "-Djava.io.tmpdir=${params.tmpdir}"
}

// 10. 流程特定配置（适配 rnaseq 模式）
process {
    withProfile: "rnaseq,singularity" {
        // 确保RNA-seq模式下的任务使用正确的资源配置
        cpus = 8
        memory = 40.GB
    }
}