// 1. 全局参数配置（仅保留核心必要参数，不与命令行冲突）
params {
    // 容器相关配置（统一管理，避免命令行冗长）
    singularity_cache_dir = "$HOME/singularity_cache"
    singularity_pull_timeout = "60m"
    tmpdir = "$PWD/global_tmp"  // 本地临时目录（替代系统 /tmp）
}

// 2. 进程资源配置（核心修复+适配 SLURM 申请资源）
process {
    // 全局资源限制（不超过 SBATCH 申请的 15 CPU / 80GB 内存）
    resourceLimits = [
        cpus: 15,
        memory: 80.GB,
        time: 24.h
    ]
    
    // 关键修复：将 params.tmpdir 传递给任务环境变量（解决 FASTQC 临时文件问题）
    env {
        TMPDIR = params.tmpdir
    }
    
    // 精准配置高资源需求任务（STAR 基因组构建必须 72GB 内存）
    withName: STAR_GENOMEGENERATE {
        cpus = 12
        memory = 80.GB
        time = 8.h
        errorStrategy = "retry"
        maxRetries = 1
    }
    
    // 其他任务默认资源（按需调整，不超全局限制）
    cpus = 6
    memory = 20.GB
    time = 4.h
    errorStrategy = "retry"
    maxRetries = 1
}

// 3. SLURM 执行器配置（适配集群调度器，官方规范）
singularity {
    enabled = true
    autoMounts = true  // 自动挂载宿主目录，确保临时目录/输入文件可访问
    cacheDir = params.singularity_cache_dir
    pullTimeout = params.singularity_pull_timeout
    pullRateLimit = "100MB"  // 避免下载限速
}

// 4. 执行器配置（关键调整，适配调度器）
executor {
    name = "local"  // 核心：改为本地执行
    maxParallelProcesses = 2  // 最大并行任务数（≤ sbatch 申请的 CPU 数，避免资源超用）
}

// 5. 日志与追踪配置（确保路径不报错）
trace {
    enabled = true
    file = "${params.outdir}/nextflow_trace.txt"
    fields = "task_id,name,status,exit,cpus,memory,time,duration"
}

report {
    enabled = true
    file = "${params.outdir}/nextflow_report.html"
}

timeline {
    enabled = true
    file = "${params.outdir}/nextflow_timeline.html"
}

// 6. 兼容性与优化配置
manifest {
    nextflowVersion = ">=22.10.0"
    description = "nf-core/rna_seq  小鼠 RNA-seq 分析（GRCm39 基因组）"
    author = "sunxiaozhi"
}

wave {
    wave.enabled = false
    singularity.enabled = true
    singularity.cacheDir = "$HOME/singularity_cache"
}

cache {
    enabled = true
    dir = "$PWD/nextflow_cache"  // 缓存已完成任务，加速 resume
}